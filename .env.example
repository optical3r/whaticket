# MYSQL
MYSQL_ENGINE=
MYSQL_VERSION=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=whaticket
MYSQL_PORT=
TZ=

# BACKEND
BACKEND_PORT=
BACKEND_SERVER_NAME=api.mydomain.com
BACKEND_URL=https://api.mydomain.com
PROXY_PORT=443
# Required, at least 32 characters each. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# First admin user. Empty password = a random one is printed by the seed.
ADMIN_EMAIL=admin@cerqueiralabs.com
ADMIN_PASSWORD=

# FRONTEND
# Product name shown in the interface (the logo stays Cerqueira Labs)
BRAND_NAME=Cerqueira Labs
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443
FRONTEND_SERVER_NAME=myapp.mydomain.com
FRONTEND_URL=https://myapp.mydomain.com

# BROWSERLESS
MAX_CONCURRENT_SESSIONS=

# PHPMYADMIN
PMA_PORT=

# MEDIA STORAGE: local (backend/public) or s3 (AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
# Cloudflare R2 example: https://<account-id>.r2.cloudflarestorage.com, region auto
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and other servers that use path-style URLs
S3_FORCE_PATH_STYLE=false

# AI (Claude): suggestions, summaries and the virtual assistant.
# Get a key at https://platform.claude.com. Empty = AI off.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# BACKUP (scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
