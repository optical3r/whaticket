# WhatsApp Provider Configuration
# Supported providers: wwebjs, zapo (whaileys is an alias of zapo)
WHATSAPP_PROVIDER=wwebjs

# Logging (silent, fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
# Log level for the zapo provider (trace, debug, info, warn, error)
ZAPO_LOG_LEVEL=error
# SQLite file where the zapo provider keeps WhatsApp session state
ZAPO_AUTH_PATH=.zapo_auth/state.sqlite

# Chrome/Puppeteer Configuration
CHROME_BIN=
CHROME_WS=
CHROME_ARGS=--no-sandbox --disable-setuid-sandbox

# Database
DB_HOST=localhost
DB_DIALECT=mysql
DB_PORT=3306
DB_NAME=whaticket
DB_USER=root
DB_PASS=

# JWT secrets: required, at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# First admin user created by the seed. If ADMIN_PASSWORD is empty, a random
# password is generated and printed once when the seed runs.
ADMIN_EMAIL=admin@cerqueiralabs.com
ADMIN_PASSWORD=

# Number of reverse proxies in front of the backend (1 with the bundled nginx).
# Leave empty when the backend is reached directly.
TRUST_PROXY=

# Backend URL
BACKEND_URL=http://localhost:8080

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Proxy
PROXY_PORT=8080

# Background jobs (webhooks and automatic messages with retries).
# Leave empty to run them inline, without Redis.
REDIS_URL=
QUEUE_CONCURRENCY=5

# Media storage: local (public folder) or s3 (S3-compatible bucket)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=media/

# AI (Claude). Without a key, AI features stay off.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Encrypts the API keys companies enter (plans that use the client's key) and
# the Cloud API tokens and app secrets.
# Empty = derived from JWT_SECRET. Changing it means they must be entered again.
DATA_ENCRYPTION_KEY=
# Wait before the virtual assistant answers, to group messages sent together.
AI_ASSISTANT_DELAY_MS=8000

# WhatsApp Cloud API (official connections). Change only for tests.
WHATSAPP_CLOUD_API_URL=https://graph.facebook.com/v21.0
